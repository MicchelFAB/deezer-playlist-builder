# Exemplo de configuração para add-tracks-manual.sh
# Copie para .env.local e preencha com seus valores reais

# Token de API do Deezer (encontre em api_token=... no curl do DevTools)
export DEEZER_API_TOKEN="your_token_here"

# Seu User ID do Deezer (encontre em x-deezer-user: ... no curl)
export DEEZER_USER_ID="your_user_id_here"

# String COMPLETA dos cookies do navegador
# Copie tudo após -H 'Cookie: ...' do curl do DevTools
export DEEZER_COOKIES="sid=...; dzr_uniq_id=...; arl=...; jwt=...; bm_sz=...; [todo o resto]"

# ID da sua playlist do Deezer
export DEEZER_PLAYLIST_ID="your_playlist_id_here"

# ===== INSTRUÇÕES =====
# 1. Copie este arquivo: cp .env.example .env.local
# 2. Edite .env.local com seus valores reais
# 3. Carregue as variáveis: source .env.local
# 4. Execute: ./add-tracks-manual.sh
